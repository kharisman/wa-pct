# WhatsApp Cloud API — ambil dari Meta App Dashboard > WhatsApp > API Setup
WA_TOKEN=            # System User access token (permanen, jangan yang 24 jam)
WA_PHONE_ID=         # Phone number ID
WA_WABA_ID=          # WhatsApp Business Account ID (buat list template & broadcast)
WA_VERIFY_TOKEN=rahasia-bebas   # string bebas, dipakai saat verifikasi webhook di Meta
PORT=3000

# Database — Supabase Postgres (Project > Connect > Connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# S3 (opsional) — media disimpan ke S3, bukan disk. Kosongkan = pakai disk lokal.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
